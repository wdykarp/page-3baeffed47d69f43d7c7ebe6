op;text-align:left;font-size:13px;color:var(--ink-soft);padding:0 0 10px}\nth,td{border:1px solid var(--hair);padding:13px 15px;vertical-align:top;text-align:left}\nthead th{background:#fafafa;border-bottom:2px solid var(--line);font-size:14px}\nthead th .pname{display:block;font-size:18px;font-weight:800;margin-bottom:2px}\nthead th .price{color:var(--orange-deep);font-weight:800;font-size:15px}\nthead th .per{display:block;font-size:12.5px;color:var(--ink-soft);font-weight:500}\nthead th.hot{background:var(--tint);position:relative}\n.badge-hot{display:inline-block;background:var(--orange);color:#fff;font-size:11px;font-weight:700;letter-spacing:.08em;padding:1px 7px;margin-bottom:6px}\ntbody th{width:132px;background:#fcfcfc;font-weight:700;font-size:13.5px;color:#333}\ntd.yes{color:#1c1c1c}\ntd.no{color:#9a9a9a}\n.tfoot td{background:#fafafa;font-size:13px;color:var(--ink-soft)}\n.plan-hint{margin:16px 0 0;font-size:14px;color:var(--ink-soft);border-left:4px solid var(--orange);padding-left:12px}\n\n/* steps */\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.step{border:2px solid var(--line);padding:20px 18px 18px;background:#fff}\n.step b{display:block;font-size:12px;letter-spacing:.16em;color:var(--orange);margin-bottom:10px}\n.step h3{font-size:17px;margin-bottom:8px}\n.step p{margin:0;font-size:14px;color:var(--ink-soft)}\n.clients{margin-top:26px;border:2px solid var(--line);padding:18px 20px}\n.clients h3{font-size:16px;margin-bottom:8px}\n.clients ul{margin:0;padding-left:18px;font-size:14px;color:var(--ink-soft)}\n.clients li{margin-bottom:4px}\n.clients li strong{color:var(--ink)}\n\n/* faq: diptych */\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:2px solid var(--line)}\n.faq-col{padding:24px 22px}\n.faq-col + .faq-col{border-left:2px solid var(--line)}\n.faq-col h3{font-size:13px;letter-spacing:.16em;color:var(--orange);margin-bottom:16px;font-weight:800}\n.qa{border-top:1px solid var(--hair);padding:14px 0 4px}\n.qa:first-of-type{border-top:0;padding-top:0}\n.qa h4{font-size:15.5px;margin:0 0 6px;font-weight:700}\n.qa p{margin:0;font-size:14px;color:var(--ink-soft)}\n\n/* note strip */\n.strip{background:var(--tint);border-top:2px solid var(--line)}\n.strip-in{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:26px 40px}\n.strip-in h3{font-size:15px;margin-bottom:6px}\n.strip-in p{margin:0;font-size:13.5px;color:var(--ink-soft)}\n\nfooter{padding:26px 40px 34px;font-size:13px;color:var(--ink-soft);border-top:2px solid var(--line)}\nfooter strong{color:var(--ink)}\n\n@media (max-width:900px){\n  .shell{display:block}\n  .rail{position:static;width:auto;min-height:0;border-right:0;border-bottom:2px solid var(--line);padding:20px 22px;flex-direction:row;flex-wrap:wrap;align-items:center;gap:14px 20px}\n  .rail-brand{font-size:19px}\n  .rail-nav{flex-direction:row;flex-wrap:wrap;border-top:0;padding-top:0;gap:4px 14px;width:100%}\n  .rail-nav a{border-bottom:0;padding:4px 0;font-size:13.5px}\n  .rail-note{margin:0;width:100%}\n  .band-a{grid-template-columns:1fr;gap:16px}\n  .band-c{grid-template-columns:1fr;gap:18px;padding:22px 22px 26px}\n  .band,.section{padding-left:22px;padding-right:22px}\n  .band-b{padding:16px 22px}\n  .steps{grid-template-columns:1fr}\n  .faq-grid{grid-template-columns:1fr}\n  .faq-col + .faq-col{border-left:0;border-top:2px solid var(--line)}\n  .strip-in{grid-template-columns:1fr;padding:22px}\n  footer{padding:22px}\n}\n</style><div class=\"shell\">\n\n  <aside class=\"rail\">\n    <a class=\"rail-brand\" href=\"#top\">OK网络<span>SUBSCRIPTION NOTES</span></a>\n    <nav class=\"rail-nav\" aria-label=\"页面目录\">\n      <a href=\"#plans\"><b>01</b>订阅套餐</a>\n      <a href=\"#how\"><b>02</b>怎么用</a>\n      <a href=\"#clients\"><b>03</b>客户端说明</a>\n      <a href=\"#faq\"><b>04</b>常见问题</a>\n      <a href=\"#billing\"><b>05</b>续费与调整</a>\n    </nav>\n    <p class=\"rail-note\">这是一页订阅说明。价格、流量与设备数都在下方表格里，先看完再决定买哪一档，不着急。</p>\n  </aside>\n\n  <main class=\"stage\" id=\"top\">\n\n    <header class=\"hero\">\n      <div class=\"band band-a\">\n        <div>\n          <p class=\"eyebrow\">OK网络 / 订阅说明页</p>\n          <h1>OK网络：把套餐、用法和疑问，<em>一次说清楚</em></h1>\n          <p class=\"hero-lede\">我们不打算用一堆形容词说服你。这一页只做三件事：把三档订阅并排摊开、把上手步骤写明白、把大家最常问的问题老实回答。看完还拿不准，就挑最小的那档先试试。</p>\n        </div>\n        <div class=\"band-tag\">\n          <strong>3 档</strong>\n          基础 / 旗舰 / 团队<br>\n          月付与年付两种付法<br>\n          年付价见下表\n        </div>\n      </div>\n\n      <div class=\"band band-b\">\n        <p>先看清楚，再点购买——表格在下面第二屏。</p>\n        <a href=\"#plans\">直接看套餐对比 ↓</a>\n        <a href=\"#faq\">我有个问题，先看 FAQ ↓</a>\n      </div>\n\n      <div class=\"band band-c\">\n        <h2>三句话认识 OK网络</h2>\n        <div class=\"mini\">\n          <strong>按设备数选档</strong>\n          <span>一个人用、家里两三台、还是小团队一起用，量的差别比价钱的差别更重要。</span>\n        </div>\n        <div class=\"mini\">\n          <strong>月付年付都一样用</strong>\n          <span>年付只是把账单提前结掉，权益本身不因付款方式增减。</span>\n        </div>\n        <div class=\"mini\">\n          <strong>说不清的就不写</strong>\n          <span>关于节点、速度与兼容范围，页面只写能确认的部分，不堆承诺。</span>\n        </div>\n      </div>\n    </header>\n\n    <section class=\"section\" id=\"plans\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01</span>\n        <h2>订阅套餐对比</h2>\n        <p class=\"sec-sub\">三档订阅横向摊开看。左边一列是比较维度，右边三列是档位，从便宜到贵排。</p>\n      </div>\n\n      <div class=\"table-wrap\">\n        <table>\n          价格均为参考标价，最终以购买时页面显示为准。\n          <thead>\n            <tr>\n              <th>比较项</th>\n              <th>\n                <span class=\"pname\">基础版</span>\n                <span class=\"price\">¥15 / 月</span>\n                <span class=\"per\">年付 ¥150 / 年</span>\n              </th>\n              <th class=\"hot\">\n                <span class=\"badge-hot\">多数人选择</span>\n                <span class=\"pname\">旗舰版</span>\n                <span class=\"price\">¥35 / 月</span>\n                <span class=\"per\">年付 ¥350 / 年</span>\n              </th>\n              <th>\n                <span class=\"pname\">团队版</span>\n                <span class=\"price\">¥85 / 月</span>\n                <span class=\"per\">年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月度流量</th>\n              <td class=\"yes\">100GB</td>\n              <td class=\"yes\">300GB</td>\n              <td class=\"yes\">1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td class=\"yes\">3 台</td>\n              <td class=\"yes\">5 台</td>\n              <td class=\"yes\">20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td class=\"yes\">基础流媒体</td>\n              <td class=\"yes\">全节点原生流媒体解锁</td>\n              <td class=\"yes\">全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>线路说明</th>\n              <td class=\"yes\">普通线路节点池</td>\n              <td class=\"yes\">IPLC 专线游戏加速优化</td>\n              <td class=\"yes\">VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>路由自定义</th>\n              <td class=\"no\">不提供</td>\n              <td class=\"no\">不提供</td>\n              <td class=\"yes\">支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>响应方式</th>\n              <td class=\"yes\">常规工单</td>\n              <td class=\"yes\">7×24 优先工单</td>\n              <td class=\"yes\">专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td class=\"yes\">一个人，日常够用就行</td>\n              <td class=\"yes\">手机电脑平板一起上的人</td>\n              <td class=\"yes\">几台设备到一群人的小团队</td>\n            </tr>\n          </tbody>\n          <tfoot>\n            <tr class=\"tfoot\">\n              <td>年付金额为按月付价折算后的整年价，差额已在各列标出；中途升档的处理方式见下方“续费与调整”。</td>\n            </tr>\n          </tfoot>\n        </table>\n      </div>\n      <p class=\"plan-hint\">拿不准的话，先看你有几台设备要连：一台到两台，基础版；三四台且会同时用，旗舰版；超过五台或者身边有人要一起用，直接看团队版。</p>\n    </section>\n\n    <section class=\"section\" id=\"how\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02</span>\n        <h2>上手三步，别想复杂了</h2>\n        <p class=\"sec-sub\">从付款到能正常使用，实际要做的事情只有三件。哪一步卡住了，先翻到下面的常见问题。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <b>STEP 01</b>\n          <h3>先确定档位与周期</h3>\n          <p>照上一节的方法数设备、估流量，选定一档。月付适合先试试看，年付适合确定会长期用的人，两者权益一致。</p>\n        </article>\n        <article class=\"step\">\n          <b>STEP 02</b>\n          <h3>在你常用的设备上配置</h3>\n          <p>配置入口和参数以购买后提供的说明为准。建议先在主力设备上跑通，再同步到其他设备，出问题时排查范围更小。</p>\n        </article>\n        <article class=\"step\">\n          <b>STEP 03</b>\n          <h3>留意设备数与流量</h3>\n          <p>同时在线设备数按档位计算，切走不用的设备能腾出位置。流量按月计，月底前用不完的部分不结转到下月。</p>\n        </article>\n      </div>\n\n      <div class=\"clients\" id=\"clients\">\n        <h3>客户端与设备说明</h3>\n        <ul>\n          <li><strong>设备计数规则：</strong>基础版 3 台、旗舰版 5 台、团队版 20 台为同时在线数，不是累计绑定数；换设备时先断开旧的那台。</li>\n          <li><strong>客户端选择：</strong>请使用你所选操作系统上惯用的客户端，本页不指定具体软件名称与版本，具体以购买后的配置说明为准。</li>\n          <li><strong>下载来源：</strong>本页不提供任何下载地址，也不代为分发安装包；请从你信任的官方渠道获取客户端。</li>\n          <li><strong>多设备场景：</strong>手机、平板、电脑同时在线也算多台，旗舰版与团队版的差别主要就体现在这里。</li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"faq\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03</span>\n        <h2>常见问题</h2>\n        <p class=\"sec-sub\">左边是“买之前想问的”，右边是“买了之后会遇到的”。没找到答案，就从工单入口问我们。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <div class=\"faq-col\">\n          <h3>买之前</h3>\n          <div class=\"qa\">\n            <h4>三档之间真正的差别是什么？</h4>\n            <p>主要是三样：月度流量、同时在线设备数、线路类型。功能列表看起来都差不多，但设备数和流量决定了你用起来顺不顺手。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>我只有一台手机，需要买旗舰版吗？</h4>\n            <p>通常不需要。基础版 3 台设备、100GB 流量对单人日常已经够用。等你发现设备位置不够、或者流量见底，再升档也不迟。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>月付和年付，权益有区别吗？</h4>\n            <p>没有。年付只是把一年的费用一次结清，价格上更省一点；档位本身的流量与设备数完全一样。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>团队版是不是一定要有公司？</h4>\n            <p>不一定。它解决的是“设备多、要分给几个人用”这件事。只是团队版包含定制路由和客户经理这类偏组织向的内容，个人用不上也别为此多花钱。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-col\">\n          <h3>买了之后</h3>\n          <div class=\"qa\">\n            <h4>同时在线设备数是怎么算的？</h4>\n            <p>按同一时刻正在连接的数量算，不按你曾经装过几台算。手机和电脑同时开着就算两台，关掉一台就空出一个位置。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>流量用超了会怎样？</h4>\n            <p>月度流量按档位上限使用，用尽后当月不再计入新的用量，需要等下个计费周期重置，或者申请升档。具体处理以购买时的说明为准。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>某天突然连不上了，先查什么？</h4>\n            <p>按顺序来：先看设备数是否已满，再看当月流量是否用完，最后确认本地网络本身是通的。这三项排除掉，再提交工单，描述会清楚很多。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>能退款吗？</h4>\n            <p>本页不承诺任何退款政策，也没有可引用的条款。请在购买前确认当期规则，或在下单前直接问清楚，别等到事后再说。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"strip\" id=\"billing\">\n      <div class=\"strip-in\">\n        <div>\n          <h3>续费</h3>\n          <p>月付与年付都按所选周期结算。到期前记得处理，避免周期结束后无法继续使用。</p>\n        </div>\n        <div>\n          <h3>升档</h3>\n          <p>从基础版升到旗舰版或团队版，属于换档而非叠加，具体折算方式请以购买页面显示为准。</p>\n        </div>\n        <div>\n          <h3>降档</h3>\n          <p>降档会在当前周期结束后生效，当期权益不变。设备较多时，请先确认新档位的设备数够用。</p>\n        </div>\n      </div>\n    </section>\n\n    <footer>\n      <p><strong>OK网络</strong> · 本页为订阅说明性质的内容，价格与权益以购买时页面显示为准。页面不提供安装包下载，也不对节点、速度或兼容范围作额外承诺。有问题请通过工单入口联系我们。</p>\n    </footer>\n\n  </main>\n</div>",
